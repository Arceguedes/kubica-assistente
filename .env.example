# Claude: uma chave por serviço (workspace Kubica)
VIC_ANTHROPIC_API_KEY=
HEX_ANTHROPIC_API_KEY=

META_TOKEN=
META_PHONE_NUMBER_ID=
META_WABA_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Infra local: gerar cada valor com "openssl rand -hex 24" no Git Bash.
# Todos os clones do projeto precisam usar os mesmos valores.
POSTGRES_PASSWORD=
N8N_ENCRYPTION_KEY=

# VIC: o Postgres é o do compose (usuário kubica, banco kubica) e a senha vem de
# POSTGRES_PASSWORD. Só preencha se o banco estiver em outro lugar:
# POSTGRES_HOST=localhost
# VIC_DATABASE_URL=
# PORT=3001
