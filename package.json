{
  "name": "kubica-assistente",
  "private": true,
  "scripts": {
    "dev:vic": "npm --prefix services/vic run start:dev",
    "dev:hex": "npm --prefix services/hex run start:dev",
    "dev:gateway": "npm --prefix gateway run start:dev",
    "install:all": "npm --prefix services/vic i && npm --prefix services/hex i && npm --prefix gateway i",
    "infra:up": "docker compose --env-file .env -f infra/docker-compose.yml up -d",
    "infra:ps": "docker compose --env-file .env -f infra/docker-compose.yml ps",
    "infra:logs": "docker compose --env-file .env -f infra/docker-compose.yml logs -f --tail 100",
    "infra:embed": "docker compose --env-file .env -f infra/docker-compose.yml exec ollama ollama pull nomic-embed-text",
    "infra:down": "docker compose --env-file .env -f infra/docker-compose.yml down",
    "test:hooks": "node --test \".claude/hooks/*.test.mjs\"",
    "tunnel": "cloudflared tunnel --url http://localhost:3000",
    "meta:assinar": "node --env-file=.env scripts/meta-assinar-webhook.mjs",
    "meta:url": "node --env-file=.env scripts/meta-trocar-url.mjs"
  }
}
